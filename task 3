#include <iostream>
#include <string>
using namespace std;

int main()
{
    string pattern[] = {
        "*   *   ***    *   *   *****   *",
        "*   *  *   *   ** **     *     *",
        "*****  *****   * * *     *     *",
        "*   *  *   *   *   *     *     *",
        "*   *  *   *   *   *   *****   *****"
    };

    for(int i = 0; i < 5; i++)
    {
        for(int j = 0; j < pattern[i].length(); j++)
        {
            putchar(pattern[i][j]);
        }
        putchar('\n');
    }

    return 0;
}
